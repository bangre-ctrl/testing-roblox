--==================================================
-- UPDATE COUNTER
--==================================================

local function updateCounter()

    rollCount.Text =
        "Roll Count: "..totalRolls

    if startTime > 0 then

        local elapsed = os.clock() - startTime

        if elapsed > 0 then

            rollSpeed.Text = string.format(
                "Actual Speed: %.2f roll/s",
                totalRolls / elapsed
            )

        end

    end

end

--==================================================
-- WORKER
--==================================================

local function worker(id)

    while running do

        local success, result = pcall(function()
            return RollDice:InvokeServer()
        end)

        if success then

            totalRolls += 1
            updateCounter()

        else

            warn(
                "[Worker "..id.."] Roll Error:",
                result
            )

        end

        task.wait(rollDelay)

    end

end

--==================================================
-- TOGGLE
--==================================================

toggle.MouseButton1Click:Connect(function()

    running = not running

    if running then

        totalRolls = 0
        startTime = os.clock()

        status.Text = "● ON — 2 WORKERS"
        status.TextColor3 =
            Color3.fromRGB(80,255,100)

        toggle.Text = "🎲 2 WORKER : ON"
        toggle.BackgroundColor3 =
            Color3.fromRGB(40,170,75)

        task.spawn(function()
            worker(1)
        end)

        task.spawn(function()
            worker(2)
        end)

    else

        status.Text = "● OFF"
        status.TextColor3 =
            Color3.fromRGB(255,80,80)

        toggle.Text = "🎲 2 WORKER : OFF"
        toggle.BackgroundColor3 =
            Color3.fromRGB(170,45,45)

    end

end)

--==================================================
-- DRAG
--==================================================

local dragging = false
local dragStart
local startPos

titleBar.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPos = frame.Position

        input.Changed:Connect(function()

            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end

        end)

    end

end)

UIS.InputChanged:Connect(function(input)

    if not dragging then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then

        local delta = input.Position - dragStart

        frame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )

    end

end)

--==================================================
-- MINIMIZE
--==================================================

minimize.MouseButton1Click:Connect(function()

    minimized = not minimized

    if minimized then

        content.Visible = false
        frame.Size = UDim2.new(0,300,0,40)
        minimize.Text = "□"

    else

        content.Visible = true
        frame.Size = UDim2.new(0,300,0,260)
        minimize.Text = "—"

    end

end)

--==================================================
-- CLOSE
--==================================================

close.MouseButton1Click:Connect(function()

