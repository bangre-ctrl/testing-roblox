local autoRollOn = false

toggle(
    Left,
    "🎲  Auto Roll Dice",
    nextLeft(),

    function()
        autoRollOn = true
        status("Auto Roll Dice: ON")

        task.spawn(function()
            while autoRollOn do

                pcall(function()
                    invokeRF("RollService", "RollDice")
                end)

                task.wait(0.3)
            end

            status("Auto Roll Dice: OFF")
        end)
    end,

    function()
        autoRollOn = false
        status("Auto Roll Dice: STOPPING...")
    end
)
