--// STANDALONE AUTO ROLL TEST

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

--==================================================
-- NETWORK
--==================================================

local function getNetwork()
    return ReplicatedStorage:WaitForChild("Network", 10)
end

local function invokeRF(serviceName, remoteName, ...)
    local network = getNetwork()

    if not network then
        error("Network tidak ditemukan")
    end

    local service = network:WaitForChild(serviceName, 10)

    if not service then
        error(serviceName .. " tidak ditemukan")
    end

    local folder = service:WaitForChild("RF", 10)

    if not folder then
        error(serviceName .. " > RF tidak ditemukan")
    end

    local remote = folder:WaitForChild(remoteName, 10)

    if not remote then
        error(serviceName .. " > RF > " .. remoteName .. " tidak ditemukan")
    end

    if not remote:IsA("RemoteFunction") then
        error(remote:GetFullName() .. " bukan RemoteFunction")
    end

    return remote:InvokeServer(...)
end

--==================================================
-- TEST REMOTE
--==================================================

local success, result = pcall(function()
    return invokeRF("RollService", "RollDice")
end)

if success then
    print("[AutoRollTest] Roll berhasil!")
    print("[AutoRollTest] Result:", result)
else
    warn("[AutoRollTest] Roll gagal:", result)
end

