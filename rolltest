speedLabel.Position = UDim2.new(0, 10, 0, 75)
speedLabel.BackgroundTransparency = 1
speedLabel.Text = "Roll Delay: 0.30s"
speedLabel.TextColor3 = Color3.new(1,1,1)
speedLabel.TextSize = 14
speedLabel.Font = Enum.Font.Gotham
speedLabel.Parent = frame

--==================================================
-- PRESET BUTTONS
--==================================================

local delays = {
    {text = "0.30s", value = 0.30},
    {text = "0.20s", value = 0.20},
    {text = "0.10s", value = 0.10},
    {text = "0.05s", value = 0.05}
}

local buttons = {}

for i, data in ipairs(delays) do

    local b = Instance.new("TextButton")

    b.Size = UDim2.new(0, 58, 0, 35)
    b.Position = UDim2.new(0, 10 + ((i-1) * 66), 0, 105)

    b.BackgroundColor3 = Color3.fromRGB(55,55,65)
    b.Text = data.text
    b.TextColor3 = Color3.new(1,1,1)
    b.TextSize = 13
    b.Font = Enum.Font.GothamBold
    b.BorderSizePixel = 0
    b.Parent = frame

    Instance.new("UICorner", b).CornerRadius = UDim.new(0,7)

    buttons[i] = b

    b.MouseButton1Click:Connect(function()

        -- Jangan mengubah speed saat sedang running
        -- supaya loop tetap stabil; speed baru berlaku
        -- pada roll berikutnya.
        rollDelay = data.value

        speedLabel.Text =
            string.format("Roll Delay: %.2fs", rollDelay)

        for _, other in ipairs(buttons) do
            other.BackgroundColor3 = Color3.fromRGB(55,55,65)
        end

        b.BackgroundColor3 = Color3.fromRGB(45,140,75)

        print("[RollSpeed] Delay:", rollDelay)
    end)
end

--==================================================
-- ON / OFF
--==================================================

local toggle = Instance.new("TextButton")

toggle.Size = UDim2.new(1, -20, 0, 42)
toggle.Position = UDim2.new(0, 10, 0, 150)

toggle.BackgroundColor3 = Color3.fromRGB(170,45,45)
toggle.Text = "🎲 AUTO ROLL : OFF"
toggle.TextColor3 = Color3.new(1,1,1)
toggle.TextSize = 16
toggle.Font = Enum.Font.GothamBold
toggle.BorderSizePixel = 0
toggle.Parent = frame

Instance.new("UICorner", toggle).CornerRadius = UDim.new(0,8)

--==================================================
-- AUTO ROLL
--==================================================

local running = false
local rollDelay = 0.30

toggle.MouseButton1Click:Connect(function()

    running = not running

    if running then

        toggle.Text = "🎲 AUTO ROLL : ON"
        toggle.BackgroundColor3 = Color3.fromRGB(40,170,75)

        status.Text = "● ON"
        status.TextColor3 = Color3.fromRGB(80,255,100)

        task.spawn(function()

            while running do

                local ok, result = pcall(function()
                    return RollDice:InvokeServer()
                end)

                if not ok then
                    warn("[AutoRoll] ERROR:", result)
                end

                task.wait(rollDelay)
            end

        end)

    else

        toggle.Text = "🎲 AUTO ROLL : OFF"
        toggle.BackgroundColor3 = Color3.fromRGB(170,45,45)

        status.Text = "● OFF"
        status.TextColor3 = Color3.fromRGB(255,80,80)

    end
end)

--==================================================
-- DRAG
--==================================================

local dragging = false
local dragStart
local startPos

titleBar.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPos = frame.Position

        input.Changed:Connect(function()

            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end

        end)
    end
end)

UIS.InputChanged:Connect(function(input)

    if not dragging then return end

    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then

        local delta = input.Position - dragStart

        frame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

--==================================================
-- MINIMIZE
--==================================================

local minimized = false

minimize.MouseButton1Click:Connect(function()

    minimized = not minimized

    if minimized then

        for _, child in ipairs(frame:GetChildren()) do
            if child ~= titleBar then
                child.Visible = false
            end
        end

        titleBar.Visible = true
        frame.Size = UDim2.new(0, 280, 0, 38)
        minimize.Text = "□"

    else

        frame.Size = UDim2.new(0, 280, 0, 235)

        for _, child in ipairs(frame:GetChildren()) do
            child.Visible = true
        end

        minimize.Text = "—"
    end
end)

--==================================================
-- CLOSE
--==================================================

close.MouseButton1Click:Connect(function()

    running = false
    gui:Destroy()

end)

print("[RollSpeedTest] Loaded successfully!")
