local Player = Players.LocalPlayer

--==================================================
-- ROLL REMOTE
--==================================================

local RollDice = RS
    :WaitForChild("Network")
    :WaitForChild("RollService")
    :WaitForChild("RF")
    :WaitForChild("RollDice")

--==================================================
-- GUI
--==================================================

