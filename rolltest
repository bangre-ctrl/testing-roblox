--==================================================
-- AUTO ROLL
--==================================================

local autoRoll = false

local function updateGUI()
    if autoRoll then
        status.Text = "● ON"
        status.TextColor3 = Color3.fromRGB(80, 255, 100)

        button.Text = "ON"
        button.BackgroundColor3 = Color3.fromRGB(45, 170, 75)
    else
        status.Text = "● OFF"
        status.TextColor3 = Color3.fromRGB(255, 80, 80)

        button.Text = "OFF"
        button.BackgroundColor3 = Color3.fromRGB(170, 45, 45)
    end
end

button.MouseButton1Click:Connect(function()

    autoRoll = not autoRoll
    updateGUI()

    if autoRoll then

        task.spawn(function()

            while autoRoll do

                local success, result = pcall(function()
                    return invokeRF("RollService", "RollDice")
                end)

                if success then
                    print("[AutoRoll] Roll OK", result)
                else
                    warn("[AutoRoll] Roll ERROR:", result)
                end

                task.wait(0.3)
            end

        end)

    end
end)

updateGUI()

