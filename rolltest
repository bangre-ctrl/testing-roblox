local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

local RollDice = RS
    :WaitForChild("Network")
    :WaitForChild("RollService")
    :WaitForChild("RF")
    :WaitForChild("RollDice")

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "SimpleAutoRoll"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local button = Instance.new("TextButton")
button.Size = UDim2.new(0, 220, 0, 55)
button.Position = UDim2.new(0.5, -110, 0.5, -27)
button.BackgroundColor3 = Color3.fromRGB(170, 45, 45)
button.Text = "🎲 AUTO ROLL : OFF"
button.TextColor3 = Color3.new(1,1,1)
button.TextSize = 17
button.Font = Enum.Font.GothamBold
button.Parent = gui

Instance.new("UICorner", button).CornerRadius = UDim.new(0, 10)

local running = false

button.MouseButton1Click:Connect(function()

    running = not running

    if running then
        button.Text = "🎲 AUTO ROLL : ON"
        button.BackgroundColor3 = Color3.fromRGB(40, 170, 75)

        task.spawn(function()

            while running do

                local ok, result = pcall(function()
                    return RollDice:InvokeServer()
                end)

                if not ok then
                    warn("[AUTO ROLL ERROR]", result)
                end

                task.wait(0.3)

            end

        end)

    else

        button.Text = "🎲 AUTO ROLL : OFF"
        button.BackgroundColor3 = Color3.fromRGB(170, 45, 45)

    end
end)

print("[SimpleAutoRoll] Loaded successfully!")
